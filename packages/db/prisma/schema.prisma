
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  googleId     String?       @unique
  email        String       @unique
  password     String?
  name         String
  username     String?       @unique 
  avatar       String?
  createdAt    DateTime     @default(now()) 
  rooms        Room[]        @relation("RoomMembers")
  messages      Message[]
  resources     Resource[]
  departmentId  String?      
  department    Department?  @relation(fields: [departmentId], references: [id])
  universityId String?
  university   University?  @relation(fields: [universityId], references: [id])
  }

model Admin {
  id    String  @unique @default(uuid())
  username   String  @unique
  password    String

}

model University {
  id          String      @id @default(uuid())
  name        String      @unique
 departments    Department[]
 users  User[]
}

model Department{
  id          String      @id @default(uuid())
  name      String       
  universityId  String
  university    University    @relation(fields: [universityId],references: [id])
  semesters     Semester[]
  users        User[]  

  @@unique([name,universityId])
}

model Semester{
  id String  @unique @default(uuid())
  number   Int
  departmentId   String
  department    Department   @relation(fields: [departmentId],references: [id])
  room    Room?

  @@unique([number,departmentId])
}

model Room {
  id     String   @id  @default(uuid())
  name   String 
  semester   Semester   @relation(fields: [semesterId],references: [id])
  semesterId  String    @unique

  members  User[]  @relation("RoomMembers")
  messages  Message[]
  channels  Channel[]
  resources Resource[]
}

model Channel {
  id        String    @id @default(uuid())
  name      String
  position  Int       @default(0)
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messages  Message[]
  resources Resource[]
  createdAt DateTime  @default(now())

  @@unique([roomId, name])
  @@index([roomId, position])
}

model Message{
  id   String @unique @default(uuid())
  content  String
  createdAt  DateTime  @default(now())
  user   User   @relation(fields: [userId],references: [id])
  userId    String
  room   Room   @relation(fields: [roomId],references: [id])
  roomId  String
  channelId String?
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}

model Resource {
  id          String   @id @default(uuid())
  name        String
  url         String
  mimeType    String?
  createdAt   DateTime @default(now())
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  channelId   String?
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([roomId, channelId, createdAt])
}
